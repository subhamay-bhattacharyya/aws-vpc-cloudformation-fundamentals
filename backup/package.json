{
  "name": "aws-vpc-cloudformation-fundamentals",
  "version": "0.0.0",
  "description": "Reusable CloudFormation nested stack templates for deploying AWS VPC infrastructure with security best practices, automated semantic versioning, and CI/CD integration.",
  "main": "index.js",
  "scripts": {
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "semantic-release": "^25.0.9"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "extends": "./scripts/plugins/release.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhamay-bhattacharyya/aws-vpc-cloudformation-fundamentals.git"
  },
  "author": "Subhamay Bhattacharyya",
  "license": "MIT",
  "keywords": ["cloudformation", "vpc", "aws", "infrastructure", "nested-stacks"],
  "bugs": {
    "url": "https://github.com/subhamay-bhattacharyya/aws-vpc-cloudformation-fundamentals/issues"
  },
  "homepage": "https://github.com/subhamay-bhattacharyya/aws-vpc-cloudformation-fundamentals#readme"
}
